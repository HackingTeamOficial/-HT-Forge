# HT Forge - .gitignore

# Python caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Test / coverage caches
.pytest_cache/
.coverage
htmlcov/
coverage.xml
.tox/
.mypy_cache/
.ruff_cache/

# Runtime artifacts (generated at execution)
*.db
*.sqlite
*.sqlite3
runtime/
logs/
pids/
reports/
sessions/

# Virtual environments
venv/
.venv/
env/
.env

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Distribution / build
build/
dist/
*.egg-info/
.eggs/

# Local config overrides
config.local.yaml
config.local.json
